{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticPrefixFixDepsChoreOthers",
    ":ignoreUnstable",
    "group:monorepos",
    "group:recommended",
    "workarounds:all",
    ":automergeAll"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 4am on Monday"],
  "timezone": "America/New_York",
  "prHourlyLimit": 10,
  "prConcurrentLimit": 20,
  "packageRules": [
    {
      "description": "Group all TypeScript-related packages together",
      "groupName": "typescript",
      "matchPackagePatterns": [
        "^@types/",
        "^typescript$",
        "^tsx$"
      ]
    },
    {
      "description": "Group all linting/formatting tools",
      "groupName": "linting",
      "matchPackagePatterns": [
        "^@biomejs/",
        "^eslint",
        "^prettier"
      ]
    },
    {
      "description": "Auto-merge patch updates for dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Auto-merge minor updates for dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "description": "Auto-merge patch updates for production dependencies",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Auto-merge GitHub Actions patches",
      "matchPackagePatterns": ["^actions/"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Conservative approach for major updates",
      "matchUpdateTypes": ["major"],
      "prBodyNotes": [
        "This is a major update that may introduce breaking changes. Please review carefully."
      ],
      "schedule": ["before 4am on first day of month"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on Monday"],
    "automerge": true
  },
  "assignees": ["@drengskapur"],
  "reviewers": ["@drengskapur"]
}
